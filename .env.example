NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=5
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/palnadu_smart_pricing
# Direct connection URL for migrations when using pooled connection (e.g. Prisma Postgres / PgBouncer)
DATABASE_DIRECT_URL=
# Explicit SSL mode for cloud PostgreSQL providers: require | prefer | disable | allow
DB_SSL=
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/palnadu_smart_pricing_test
# Production session secret must be >= 32 characters, high-entropy, and never committed
SESSION_SECRET=palnadu-development-only-session-secret-not-for-production-use-min-32-chars
SESSION_TTL_HOURS=12

# Cross-Origin Resource Sharing (CORS) allowed frontend origins
# Comma-separated list of origins (e.g., https://palnadu-storefront.vercel.app,https://palnadu-admin.vercel.app)
ALLOWED_ORIGINS=

# Media Storage Configuration: memory | disk | cloudinary
STORAGE_DRIVER=memory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web frontend API proxy destination
# Required for production build and deployment; defaults to http://127.0.0.1:3001 in development
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=
